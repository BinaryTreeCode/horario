{
  "session-context": {
    "SessionStart": [
      {
        "type": "command",
        "command": "bun ./hooks/session-start.ts",
        "timeout": 5
      }
    ]
  },
  "workspace-linter": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "bun ./hooks/workspace-check.ts",
        "timeout": 5
      }
    ]
  },
  "command-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "bun ./hooks/pre-command.ts",
            "timeout": 5
          }
        ]
      }
    ]
  }
}

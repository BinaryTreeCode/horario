---
import '../styles/global.css';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, interactive-widget=resizes-content" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Planificador de horarios offline-first: organiza tu semana con bloques de actividad, categorías, imágenes y respaldo en la nube. Funciona en celular y computadora." />
		<meta name="theme-color" content="#2d4a22" />
		<!-- Self-host: mismos woff2 que servía Google Fonts (latin, variable), sin round-trips a terceros.
		     preload = alta prioridad sin bloquear el render; font-display: swap evita FOIT. -->
		<link rel="preload" href="/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
		<link rel="preload" href="/fonts/outfit-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
		<title>{title}</title>
		<!-- Anti-destello del modo oscuro: pinta <html data-tema> antes del
		     primer render. La fuente de verdad es IndexedDB (lib/tema.ts), pero
		     abrir la BD es asincrono y sin este espejo una recarga en oscuro
		     muestra un frame blanco. -->
		<script is:inline>
			(function () {
				try {
					var pref = localStorage.getItem('np:tema') || 'sistema';
					var oscuro = pref === 'oscuro' ||
						(pref === 'sistema' && window.matchMedia('(prefers-color-scheme: dark)').matches);
					document.documentElement.dataset.tema = oscuro ? 'oscuro' : 'claro';
				} catch (e) {
					document.documentElement.dataset.tema = 'claro';
				}
			})();
		</script>
	</head>
	<body>
		<div id="app-splash" aria-hidden="true">
			<div class="splash-leaf">🌿</div>
			<div class="splash-spinner"></div>
		</div>
		<div class="app-layout">
			<slot />
		</div>
		<script>
			// Oculta el splash cuando la app hidrata (Dashboard monta su header)
			window.addEventListener('DOMContentLoaded', () => {
				const hide = () => document.getElementById('app-splash')?.remove();
				// Las islas client:only montan con JS; primer rAF tras carga es suficiente señal
				if (document.readyState === 'complete') requestAnimationFrame(hide);
				else window.addEventListener('load', () => requestAnimationFrame(hide));
				// Salvavidas: nunca más de 4s de splash
				setTimeout(hide, 4000);
			});
		</script>
	</body>
</html>

<style is:global>
  .app-layout {
    min-height: 100vh;
    display: grid;
    grid-template-areas: "content";
    grid-template-columns: 1fr;
  }

  /* Scrollbar de la página invisible (pedido del usuario): el scroll queda
     (rueda del mouse + touch), pero sin la barra flotando sobre el contenido.
     scrollbar-gutter: stable se conserva para no reacomodar la página al
     hidratar (CLS), pero la barra ya no se pinta. */
  html {
    scrollbar-gutter: stable;
    scrollbar-width: none;
  }
  html::-webkit-scrollbar {
    display: none;
  }

  /* Métricas de fuentes: whileEmpty usa fallback con métricas similares, loading aplica las reales.
    size-adjust compensa la diferencia de altura para que el swap no provoque saltos de layout. */
  @font-face {
    font-family: 'Inter-var';
    src: url('/fonts/inter-latin-wght-normal.woff2') format('woff2-variations');
    font-weight: 100 900;
    font-display: swap;
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215;
  }
  @font-face {
    font-family: 'Inter-var';
    src: url('/fonts/inter-latin-wght-normal.woff2') format('woff2-variations');
    font-weight: 100 900;
    font-display: swap;
    unicode-range: U+0100-024F, U+0259, U+1E00-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
  }
  @font-face {
    font-family: 'Outfit-var';
    src: url('/fonts/outfit-latin-wght-normal.woff2') format('woff2-variations');
    font-weight: 100 900;
    font-display: swap;
  }
  @font-face {
    font-family: 'Inter-fallback';
    src: local('Arial');
    size-adjust: 107.64%;
    ascent-override: 90.44%;
    descent-override: 22.52%;
    line-gap-override: 0%;
  }
  @font-face {
    font-family: 'Outfit-fallback';
    src: local('Arial');
    size-adjust: 100.6%;
    ascent-override: 97.5%;
    descent-override: 24.2%;
    line-gap-override: 0%;
  }

  #app-splash {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    align-content: center;
    gap: 18px;
    background: linear-gradient(160deg, #eaf4ea 0%, #d7e8d0 100%);
    transition: opacity 0.3s ease;
  }
  /* El splash se ve contra el fondo real: en oscuro, un verde claro
     destellaría justo antes de entregar la app. */
  :root[data-tema="oscuro"] #app-splash {
    background: linear-gradient(160deg, #1f2724 0%, #14181a 100%);
  }
  :root[data-tema="oscuro"] .splash-spinner {
    border-color: rgba(160, 220, 170, 0.2);
    border-top-color: #8fd08f;
  }
  .splash-leaf {
    font-size: 2.6rem;
    animation: splash-bob 1.6s ease-in-out infinite;
  }
  .splash-spinner {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 3px solid rgba(47, 107, 63, 0.2);
    border-top-color: #2f6b3f;
    animation: splash-spin 0.8s linear infinite;
  }
  @keyframes splash-bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }
  @keyframes splash-spin {
    to { transform: rotate(360deg); }
  }
</style>

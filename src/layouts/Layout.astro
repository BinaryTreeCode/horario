---
import '../styles/global.css';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Outfit:wght@600;700&display=swap" rel="stylesheet">
		<title>{title}</title>
	</head>
	<body>
		<div id="app-splash" aria-hidden="true">
			<div class="splash-leaf">🌿</div>
			<div class="splash-spinner"></div>
		</div>
		<div class="app-layout">
			<slot />
		</div>
		<script>
			// Oculta el splash cuando la app hidrata (Dashboard monta su header)
			window.addEventListener('DOMContentLoaded', () => {
				const hide = () => document.getElementById('app-splash')?.remove();
				// Las islas client:only montan con JS; primer rAF tras carga es suficiente señal
				if (document.readyState === 'complete') requestAnimationFrame(hide);
				else window.addEventListener('load', () => requestAnimationFrame(hide));
				// Salvavidas: nunca más de 4s de splash
				setTimeout(hide, 4000);
			});
		</script>
	</body>
</html>

<style is:global>
  .app-layout {
    min-height: 100vh;
    display: grid;
    grid-template-areas: "content";
    grid-template-columns: 1fr;
  }

  #app-splash {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    align-content: center;
    gap: 18px;
    background: linear-gradient(160deg, #eaf4ea 0%, #d7e8d0 100%);
    transition: opacity 0.3s ease;
  }
  .splash-leaf {
    font-size: 2.6rem;
    animation: splash-bob 1.6s ease-in-out infinite;
  }
  .splash-spinner {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 3px solid rgba(47, 107, 63, 0.2);
    border-top-color: #2f6b3f;
    animation: splash-spin 0.8s linear infinite;
  }
  @keyframes splash-bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }
  @keyframes splash-spin {
    to { transform: rotate(360deg); }
  }
</style>
